<!DOCTYPE html><html><head><title>Employee Details</title><%- include('_style') %></head>
<body>
<nav><b>Employee Portal</b><a class="lo" href="/logout">Logout</a></nav>
<div class="wrap"><div class="card">
<h1><%= employee.name %></h1>
<table>
<tr><th>Employee ID</th><td><%= employee.empId %></td></tr>
<tr><th>Email</th><td><%= employee.email %></td></tr>
<tr><th>Phone</th><td><%= employee.phone %></td></tr>
<tr><th>Department</th><td><%= employee.department %></td></tr>
<tr><th>Designation</th><td><%= employee.designation %></td></tr>
<tr><th>Salary</th><td><%= employee.salary %></td></tr>
<tr><th>Joining Date</th><td><%= employee.joiningDate.toDateString() %></td></tr>
<tr><th>Address</th><td><%= employee.address %></td></tr>
<tr><th>Skills</th><td><%= employee.skills.join(', ') %></td></tr>
</table><br>
<a class="btn" href="/">&larr; Back</a>
</div></div></body></html>
