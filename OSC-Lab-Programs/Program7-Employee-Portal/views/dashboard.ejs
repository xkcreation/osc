<!DOCTYPE html><html><head><title>Dashboard</title><%- include('_style') %></head>
<body>
<nav><b>Employee Portal</b><span>Admin &nbsp; <a class="lo" href="/logout">Logout</a></span></nav>
<div class="wrap">
<div class="top"><h1>Dashboard</h1><a class="btn" href="/add">+ Add Employee</a></div>
<form class="card filter" method="get" action="/">
<input type="text" name="search" placeholder="Search by name" value="<%= searchQuery || '' %>">
<select name="department">
<option value="">All Departments</option>
<% departments.forEach(d => { %><option value="<%= d %>" <%= deptQuery === d ? 'selected' : '' %>><%= d %></option><% }) %>
</select>
<button class="btn dark">Filter</button>
</form>
<table>
<tr><th>ID</th><th>Employee</th><th>Department</th><th>Designation</th><th>Actions</th></tr>
<% if (employees.length === 0) { %>
<tr><td colspan="5" class="empty">No employees found.</td></tr>
<% } %>
<% employees.forEach(e => { %>
<tr>
<td><%= e.empId %></td><td><%= e.name %></td><td><%= e.department %></td><td><%= e.designation %></td>
<td>
<a class="btn green" href="/view/<%= e._id %>">View</a>
<a class="btn" href="/edit/<%= e._id %>">Edit</a>
<form class="inline" method="post" action="/delete/<%= e._id %>" onsubmit="return confirm('Delete this employee?')">
<button class="btn red">Delete</button></form>
</td>
</tr>
<% }) %>
</table>
</div></body></html>
