<!DOCTYPE html><html><head><title>Add Employee</title><%- include('_style') %></head>
<body>
<nav><b>Employee Portal</b><a class="lo" href="/logout">Logout</a></nav>
<div class="wrap"><div class="card">
<h1>Add Employee</h1>
<form method="post" action="/add">
<label>Employee ID</label><input name="empId" required>
<label>Name</label><input name="name" required>
<label>Email</label><input type="email" name="email" required>
<label>Phone</label><input name="phone" required>
<label>Department</label><input name="department" required>
<label>Designation</label><input name="designation" required>
<label>Salary</label><input type="number" name="salary" required>
<label>Joining Date</label><input type="date" name="joiningDate" required>
<label>Address</label><textarea name="address" rows="3"></textarea>
<label>Skills (comma separated)</label><input name="skills" placeholder="Node.js, MongoDB">
<button class="btn dark" style="margin-top:18px">Save Employee</button>
<a class="btn" href="/">Cancel</a>
</form></div></div></body></html>
