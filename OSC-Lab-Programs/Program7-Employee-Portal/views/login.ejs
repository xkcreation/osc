<!DOCTYPE html><html><head><title>Admin Login</title><%- include('_style') %></head>
<body>
<div class="wrap" style="max-width:380px;margin-top:100px">
<div class="card">
<h2 style="text-align:center">Employee Portal Login</h2>
<% if (error) { %><div class="err"><%= error %></div><% } %>
<form method="post" action="/login">
<label>Username</label><input type="text" name="username" required>
<label>Password</label><input type="password" name="password" required>
<button class="btn dark" style="width:100%;margin-top:18px">Login</button>
</form>
<p style="text-align:center;color:#666;font-size:13px">Default: admin / password123</p>
</div></div></body></html>
