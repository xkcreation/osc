<style>
*{box-sizing:border-box;font-family:Arial,sans-serif}
body{margin:0;background:#f3f4f8}
nav{display:flex;justify-content:space-between;align-items:center;background:#fff;padding:14px 30px;box-shadow:0 2px 6px rgba(0,0,0,.08)}
nav b{color:#6a3fb5;font-size:18px}
nav a.lo{border:1px solid #c0392b;color:#c0392b;padding:6px 14px;border-radius:20px;text-decoration:none;font-size:14px}
.wrap{max-width:900px;margin:30px auto;padding:0 15px}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}
h1{margin:0;color:#111}
.btn{background:#5b5bf0;color:#fff;padding:9px 18px;border-radius:20px;text-decoration:none;border:none;cursor:pointer;font-size:14px}
.btn.dark{background:#1b1f2a}.btn.red{background:#c0392b}.btn.green{background:#2e8b57}
.card{background:#fff;border-radius:10px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:20px}
.filter{display:flex;gap:10px}.filter input,.filter select{flex:1;padding:10px;border:1px solid #ddd;border-radius:20px}
table{width:100%;border-collapse:collapse;background:#fff;border-radius:10px;overflow:hidden}
th{background:#111827;color:#fff;text-align:left;padding:12px}
td{padding:12px;border-bottom:1px solid #eee}
.empty{text-align:center;color:#666;padding:40px}
label{display:block;margin-top:12px;font-weight:bold}
input,select,textarea{width:100%;padding:10px;margin-top:5px;border:1px solid #ccc;border-radius:6px}
.err{background:#f8dddd;color:#a33a3a;padding:10px;border-radius:5px;margin-bottom:12px;text-align:center}
form.inline{display:inline}
</style>
